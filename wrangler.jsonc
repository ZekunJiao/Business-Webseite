{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-webseite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Kontaktformular: Versand über Cloudflare Email Routing (siehe README).
  "send_email": [
    { "name": "KONTAKT_MAIL", "destination_address": "zekun@kmu-workflow.de" }
  ],
  "vars": {
    "KONTAKT_FROM": "formular@zekun.de",
    "KONTAKT_TO": "zekun@kmu-workflow.de"
  },
  // Vorschau für den Branch main (Testadresse auf workers.dev).
  // Previews übernehmen nichts von oben, deshalb hier wiederholt.
  "previews": {
    "send_email": [
      { "name": "KONTAKT_MAIL", "destination_address": "zekun@kmu-workflow.de" }
    ],
    "vars": {
      "KONTAKT_FROM": "formular@zekun.de",
      "KONTAKT_TO": "zekun@kmu-workflow.de"
    }
  }
}
